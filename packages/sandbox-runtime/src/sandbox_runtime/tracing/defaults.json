  "ptrace_probe_timeout_seconds": 5,
  "max_deferred_events": 64,
  "max_live_tasks": 65536,
  "max_wait_batch": 256,
  "reaper_probe_seconds": 1,
  "max_pending_streams": 128,
  "upload_chunk_bytes": 262144,
  "upload_poll_seconds": 0.25,
  "upload_timeout_seconds": 3,
  "upload_flush_seconds": 35,
  "max_capture_bytes": 1073741824,
  "max_capture_files": 8192,
  "max_capture_boots": 256
